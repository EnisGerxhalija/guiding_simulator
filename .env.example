# Machine-specific settings. Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. THIS file is committed, so it holds placeholders only.
# Every line is optional; unset values use the defaults in
# src/my_project/config.py (class Settings).

# Folder containing raw/ and processed/. Relative to the project root, or an
# absolute path, e.g. a shared drive or OneDrive folder.
MY_PROJECT_DATA_DIR=data

# Each run writes a new timestamped folder in here.
MY_PROJECT_OUTPUT_DIR=outputs

# DEBUG, INFO, WARNING or ERROR
MY_PROJECT_LOG_LEVEL=INFO

# Example secret (e.g. an API token). Put the real value in .env only.
# MY_PROJECT_API_KEY=replace_me
