# Python environment and caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Data and results stay out of git; the .gitkeep files keep the empty folders
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# Private settings and computer/editor clutter
.env
.DS_Store
.vscode/
.idea/
