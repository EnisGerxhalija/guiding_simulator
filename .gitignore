# --- Environments and secrets ----------------------------------------------
.venv/
venv/
.env
.env.*
!.env.example

# --- Python caches and build artefacts --------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Docs build ---------------------------------------------------------------
site/

# --- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/

# --- Research data and generated outputs --------------------------------------
# Raw data is usually too large or sensitive for git; processed data and
# outputs can be regenerated. Remove a rule to track small files deliberately.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep

# --- OS and editor clutter ------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
